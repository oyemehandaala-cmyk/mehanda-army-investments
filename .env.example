# ─────────────────────────────────────────────────────────────────────
# MEHANDA ARMY INVESTMENTS — Server Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local or other files containing real values.
# NEVER expose these values in frontend code or customer-facing pages.
# ─────────────────────────────────────────────────────────────────────

# ── Supabase Frontend (Authentication & Customer Database) ──────────
# Get from: https://supabase.com → Project Settings → API
# For new projects, configure VITE_SUPABASE_PUBLISHABLE_KEY. The legacy
# VITE_SUPABASE_ANON_KEY remains supported for existing projects.
VITE_SUPABASE_URL=https://kqjchrgdxpydmklbcyib.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_project_publishable_key
# VITE_SUPABASE_ANON_KEY=replace_with_legacy_anon_key
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ── Supabase Server APIs (SERVER-SIDE ONLY) ─────────────────────────
# Used by private profile-photo, student-loan, and admin APIs.
# Apply section 4a for account security and section 7 for loan demos.
# Never use the secret/service-role key in any VITE_ variable or frontend code.
# Prefer the server-only secret key; the legacy service-role key remains supported.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_project_publishable_key
# Legacy alternative if the project still uses the anon key:
# SUPABASE_ANON_KEY=replace_with_legacy_anon_key
ADMIN_LOGIN_EMAIL=owner@example.com
ADMIN_USER_ID=replace-with-the-authorized-supabase-user-uuid
SUPABASE_URL=https://kqjchrgdxpydmklbcyib.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_with_project_secret_key
# SUPABASE_SERVICE_ROLE_KEY=replace_with_legacy_service_role_key
# ── Official Public Contact Details (safe to be in frontend) ────────
VITE_COMPANY_PHONE="+91 9812947813"
VITE_COMPANY_WHATSAPP="919812947813"
VITE_COMPANY_EMAIL="info@mehandaarmy.net"

# ── Google Gemini Customer Support (SERVER-SIDE ONLY) ────────────────
# Get an API key from https://aistudio.google.com/apikey
# Never use a VITE_ prefix or expose this key in frontend code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ── Razorpay Payment Gateway (SERVER-SIDE ONLY) ──────────────────────
# Get from: https://dashboard.razorpay.com → Settings → API Keys
# RAZORPAY_KEY_ID is the public key (starts with rzp_live_ or rzp_test_)
# RAZORPAY_KEY_SECRET is strictly server-side — NEVER put in VITE_ variables
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret_here

# Both test and live modes call the real Razorpay API; no simulated checkout exists.
# Set to 'live' only after the merchant account is verified and live credentials are configured.
PAYMENT_GATEWAY_MODE=test

# ── Private Receiving UPI ID (SERVER-SIDE ONLY) ──────────────────────
# YOUR PRIVATE RECEIVING UPI ID. This MUST remain strictly server-side.
# Never display it in frontend code, customer pages, receipts, or URLs.
# Used only by Razorpay during settlement to your verified bank account.
# Configure settlement directly in the Razorpay dashboard — do not pass
# UPI IDs to the customer-facing checkout.
PRIVATE_RECEIVING_UPI_ID=your_private_receiving_upi_id_here

# ── Email Delivery & Mandatory Email OTP Verification (SERVER-SIDE ONLY) ─
# Configure at least one delivery provider for live 6-digit OTP delivery.
# RESEND: https://resend.com (Recommended — modern transactional email)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="Mehanda Army Investments <no-reply@mehandaarmy.in>"

# Alternative providers:
# SENDGRID_API_KEY=your_sendgrid_api_key_here
# BREVO_API_KEY=your_brevo_api_key_here
# Optional HMAC secret for OTP hashing & token signatures (falls back to SUPABASE_SECRET_KEY)
EMAIL_OTP_SECRET=your_secure_random_otp_hmac_secret_key_here

# Alerts are sent ONLY after server-side payment verification.
# OWNER_ALERT_PHONE: The owner's configured mobile number (digits only)
# SMS_API_KEY: Your Fast2SMS API key (https://www.fast2sms.com)
#              OR your Twilio Auth Token if using Twilio
# SMS_SENDER_ID: Optional — your registered DLT sender ID
OWNER_ALERT_PHONE=your_owner_alert_phone
SMS_API_KEY=replace_with_your_sms_provider_api_key
SMS_SENDER_ID=your_registered_sender_id
SUPABASE_URL=https://kqjchrgdxpydmklbcyib.supabase.co
ADMIN_LOGIN_EMAIL=info@mehandaarmy.net
ADMIN_USER_ID=replace-with-the-authorized-supabase-user-uuid

# ── Admin Portal Security & Lockout Alerts (SERVER-SIDE ONLY) ────────
ADMIN_SECURITY_ALERT_EMAIL=mehandaarmy.info@gmail.com
GMAIL_USER=mehandaarmy.info@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
WEBAUTHN_RP_ID=mehandaarmy.net
WEBAUTHN_RP_NAME=Mehanda Army Investments
WEBAUTHN_ORIGIN=https://mehandaarmy.net
