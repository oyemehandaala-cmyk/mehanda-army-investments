# Copy this file to .env and configure the public values below.
# Only a Supabase publishable key (or legacy anon key) may be used in the app.
# Never put a service-role key, Gemini key, payment secret, or admin secret here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Required for the existing server-side AI chat and private photo-processing APIs.
# Set to the deployed website origin only (no /api suffix), for example:
# EXPO_PUBLIC_API_BASE_URL=https://your-company-site.example
EXPO_PUBLIC_API_BASE_URL=
